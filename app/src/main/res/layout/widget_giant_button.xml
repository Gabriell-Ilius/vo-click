<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRootButton"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_giant_button"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="14dp"
    android:contentDescription="Botão Grande Olhos da Vó: Toque para abrir o Gemini Live com câmera">

    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/ic_camera_sparkle"
        android:importantForAccessibility="no" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="VER COM\nO GEMINI"
        android:textColor="#FBBF24"
        android:textSize="18sp"
        android:textStyle="bold" />

</LinearLayout>
