<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090D16"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Configurações (v1.8)"
            android:textColor="#F8FAFC"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Posicione os alvos 1 e 2 e ajuste o tempo de espera de cada clique."
            android:textColor="#94A3B8"
            android:textSize="14.5sp" />

        <!-- CARD 1: PERMISSÃO DE ACESSIBILIDADE -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="#131C2E"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="#1E293B"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/tvServiceStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1. Acessibilidade: DESATIVADA"
                    android:textColor="#F87171"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenAccessibility"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:paddingVertical="12dp"
                    android:text="Ativar Serviço de Acessibilidade"
                    android:textAllCaps="false"
                    android:textColor="#0F172A"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:backgroundTint="#FFD600"
                    app:cornerRadius="14dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenAppDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:paddingVertical="10dp"
                    android:text="Abrir Dados do App (Liberar Restrição)"
                    android:textAllCaps="false"
                    android:textColor="#E2E8F0"
                    android:textSize="14sp"
                    app:backgroundTint="#1E293B"
                    app:cornerRadius="14dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- CARD 2: POSIÇÃO E TEMPO DOS CLIQUES 1 E 2 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#131C2E"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="#38BDF8"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="2. Posição e Tempo dos Cliques"
                    android:textColor="#F8FAFC"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCalibrationStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#0F172A"
                    android:padding="12dp"
                    android:text="Ainda não calibrado (toque no botão azul abaixo)"
                    android:textColor="#FBBF24"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVisualCalibrate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:paddingVertical="14dp"
                    android:text="🎯 Selecionar Lugar dos Cliques (1) e (2)"
                    android:textAllCaps="false"
                    android:textColor="#0F172A"
                    android:textSize="15.5sp"
                    android:textStyle="bold"
                    app:backgroundTint="#38BDF8"
                    app:cornerRadius="14dp" />

                <!-- Tempo 1: Espera para dar o Clique 1 (Live) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvLiveDelayLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Espera até o Clique 1 (Live): 3.0s"
                        android:textColor="#E2E8F0"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLiveDelayMinus"
                        android:layout_width="48dp"
                        android:layout_height="44dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:text="−"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        app:backgroundTint="#1E293B"
                        app:cornerRadius="10dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLiveDelayPlus"
                        android:layout_width="48dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:text="+"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        app:backgroundTint="#1E293B"
                        app:cornerRadius="10dp" />
                </LinearLayout>

                <!-- Tempo 2: Espera após o Clique 1 para dar o Clique 2 (Câmera) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvDelayLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Espera até o Clique 2 (Câmera): 5.5s"
                        android:textColor="#E2E8F0"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDelayMinus"
                        android:layout_width="48dp"
                        android:layout_height="44dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:text="−"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        app:backgroundTint="#1E293B"
                        app:cornerRadius="10dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDelayPlus"
                        android:layout_width="48dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:text="+"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        app:backgroundTint="#1E293B"
                        app:cornerRadius="10dp" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- CARD 3: WIDGET E VOZ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#131C2E"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="#1E293B"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="3. Atalho na Tela Inicial e Voz"
                    android:textColor="#F8FAFC"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPinWidget"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:paddingVertical="12dp"
                    android:text="📌 Colocar Botão Grande (Widget 2x2) na Tela Inicial"
                    android:textAllCaps="false"
                    android:textColor="#0F172A"
                    android:textSize="14.5sp"
                    android:textStyle="bold"
                    app:backgroundTint="#FFD600"
                    app:cornerRadius="14dp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swAutoLaunchOnOpen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Iniciar direto ao abrir o ícone do app"
                    android:textColor="#E2E8F0"
                    android:textSize="15sp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swVoiceFeedback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:checked="true"
                    android:text="Avisar por voz quando estiver abrindo"
                    android:textColor="#E2E8F0"
                    android:textSize="15sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- BOTÕES DE AÇÃO FINAIS -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTestNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:paddingVertical="14dp"
            android:text="▶ Testar Cliques Salvos Agora"
            android:textAllCaps="false"
            android:textColor="#052E16"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#4ADE80"
            app:cornerRadius="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloseSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:paddingVertical="12dp"
            android:text="Voltar para a Tela Principal"
            android:textAllCaps="false"
            android:textColor="#E2E8F0"
            android:textSize="15sp"
            app:backgroundTint="#1E293B"
            app:cornerRadius="16dp" />

    </LinearLayout>
</ScrollView>
