<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:padding="12dp">

    <!-- BOTÃO GIGANTE DE TELA INTEIRA PARA A AVÓ -->
    <LinearLayout
        android:id="@+id/btnGiantStart"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_giant_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:contentDescription="Botão gigante: Toque em qualquer lugar da tela para abrir o Gemini com câmera e conversar">

        <!-- Ícone Grande de Alto Contraste -->
        <ImageView
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:src="@drawable/ic_launcher_foreground"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/tvMainTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.15"
            android:text="TOQUE AQUI\nPARA VER COM\nO GEMINI"
            android:textColor="#FFD600"
            android:textSize="38sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMainSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="Abre o Gemini Live e liga a câmera automaticamente"
            android:textColor="#FFFFFF"
            android:textSize="22sp" />

        <!-- Aviso visível apenas enquanto o familiar ainda não ativou a Acessibilidade -->
        <TextView
            android:id="@+id/tvStatusBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="#B71C1C"
            android:gravity="center"
            android:padding="16dp"
            android:text="⚠️ ATENÇÃO FAMILIAR: Toque aqui para ativar a Acessibilidade na 1ª vez"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Área discreta no canto superior direito: segurar por 2 segundos abre Configurações da Família -->
    <TextView
        android:id="@+id/btnFamilySettings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="20dp"
        android:background="#262626"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:text="⚙️ Família (Segure)"
        android:textColor="#9E9E9E"
        android:textSize="13sp" />

</FrameLayout>
