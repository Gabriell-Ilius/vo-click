<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090D16"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Barra superior discreta com título e botão de Configurar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="6dp"
            android:text="✨ Olhos da Vó"
            android:textColor="#94A3B8"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnFamilySettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_settings_pill"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="⚙️ Configurar"
            android:textColor="#E2E8F0"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- CARD GIGANTE DE TELA INTEIRA PARA A AVÓ -->
    <LinearLayout
        android:id="@+id/btnGiantStart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_main_card"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:contentDescription="Botão gigante: Toque em qualquer lugar para abrir o Gemini com câmera e conversar">

        <!-- Círculo Central com Ícone Moderno de Câmera + Estrela Gemini -->
        <FrameLayout
            android:layout_width="136dp"
            android:layout_height="136dp"
            android:background="@drawable/bg_icon_glow"
            android:importantForAccessibility="no">

            <ImageView
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_camera_sparkle"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvMainTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:letterSpacing="0.02"
            android:lineSpacingMultiplier="1.15"
            android:text="TOQUE AQUI\nPARA VER COM\nO GEMINI"
            android:textColor="#FBBF24"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMainSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.2"
            android:text="Abre a câmera e conversa com você"
            android:textColor="#E2E8F0"
            android:textSize="20sp" />

        <!-- Aviso visível apenas enquanto a Acessibilidade não estiver ativa -->
        <TextView
            android:id="@+id/tvStatusBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#DC2626"
            android:gravity="center"
            android:padding="14dp"
            android:text="⚠️ Toque aqui para ativar a permissão na 1ª vez"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
